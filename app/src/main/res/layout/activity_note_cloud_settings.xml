<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/cloud_settings_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/cloud_settings_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" app:navigationIcon="@drawable/ic_arrow_back" app:title="@string/cloud_settings" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/cloud_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_enabled" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="@string/cloud_enabled_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/cloud_bucket" app:helperText="@string/cloud_bucket_desc"><com.google.android.material.textfield.TextInputEditText android:id="@+id/cloud_bucket_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/cloud_region"><AutoCompleteTextView android:id="@+id/cloud_region_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/cloud_endpoint_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/cloud_prefix" app:helperText="@string/cloud_prefix_desc"><com.google.android.material.textfield.TextInputEditText android:id="@+id/cloud_prefix_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" /></com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/cloud_credentials" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/cloud_credentials_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/cloud_access_key" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/cloud_ak_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/cloud_secret_key" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/cloud_sk_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" /></com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/cloud_local_file" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="@string/cloud_delete_mode"><AutoCompleteTextView android:id="@+id/cloud_delete_mode_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" /></com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/cloud_delete_local_desc" android:textColor="@color/toolbox_orange" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/cloud_passphrase" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/cloud_passphrase_desc" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <TextView android:id="@+id/cloud_passphrase_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/cloud_passphrase" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/cloud_passphrase_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/cloud_passphrase_confirm" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/cloud_passphrase_confirm_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/cloud_passphrase_save" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cloud_passphrase_set" />
        <com.google.android.material.button.MaterialButton android:id="@+id/cloud_restore" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/cloud_restore" />
        <TextView android:id="@+id/cloud_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/cloud_test" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cloud_test" />
    </LinearLayout></androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/cloud_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="20dp" android:text="@string/save" />
</LinearLayout>
