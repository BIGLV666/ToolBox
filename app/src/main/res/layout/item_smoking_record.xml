<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/toolbox_surface"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- 序号 -->
    <TextView
        android:id="@+id/smoking_item_index"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/toolbox_muted"
        android:textSize="12sp" />

    <!-- 分隔线 -->
    <View
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:background="@color/toolbox_outline" />

    <!-- 时间 -->
    <TextView
        android:id="@+id/smoking_item_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="@color/toolbox_ink"
        android:textSize="15sp" />

    <!-- 长按提示 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/smoking_long_press_delete"
        android:textColor="@color/toolbox_outline"
        android:textSize="11sp" />

</LinearLayout>
