<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/agent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/agent_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        app:menu="@menu/agent_toolbar"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitle="@string/agent_subtitle"
        app:title="@string/agent_title" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/agent_controls_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/colorSurface" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="46dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:textColor="?attr/colorOnSurface" android:textSize="13sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/agent_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp">
                <com.google.android.material.card.MaterialCardView android:id="@+id/model_selector" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutline" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="9dp" android:paddingEnd="16dp" android:paddingBottom="9dp">
                        <TextView android:id="@+id/selected_model_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/agent_select_model" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/selected_model_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/manage_keys" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/agent_keys" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/smart_search_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:text="@string/smart_search" android:textColor="?attr/colorOnSurface" app:useMaterialThemeColors="true" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/agent_messages" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="14dp" android:paddingTop="16dp" android:paddingEnd="14dp" android:paddingBottom="20dp" />
        <LinearLayout android:id="@+id/agent_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="36dp">
            <TextView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_agent_mark" android:gravity="center" android:text="A" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/agent_welcome" android:textColor="?attr/colorOnSurface" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:lineSpacingExtra="3dp" android:text="@string/agent_welcome_desc" android:textColor="@color/toolbox_muted" android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView android:id="@+id/agent_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="6dp" android:textColor="@color/toolbox_muted" android:textSize="12sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/agent_composer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="6dp" android:paddingEnd="14dp" android:paddingBottom="12dp">
        <HorizontalScrollView
            android:id="@+id/agent_attachment_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/agent_attachment_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom|center_vertical" android:orientation="horizontal">
            <ImageButton
                android:id="@+id/agent_attach"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/upload_word"
                android:padding="12dp"
                android:src="@drawable/ic_attach_file" />
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/agent_input_hint" app:boxCornerRadiusBottomEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusTopStart="22dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/agent_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine" android:maxLines="5" android:minLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/agent_send" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:contentDescription="@string/agent_send" app:srcCompat="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
